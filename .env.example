# Westfield Dominion - Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
APP_NAME=westfield-dominion
APP_URL=https://westfield-dominion.com

# ============================================
# AI SERVICES
# ============================================
# Replicate AI for image generation
VITE_AI_API_ENDPOINT=https://api.replicate.com/v1
VITE_AI_API_KEY=your_replicate_api_key_here
VITE_AI_MODEL=stable-diffusion-3-large

# OpenAI for copy generation
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4-turbo

# ============================================
# BACKEND API
# ============================================
VITE_API_BASE_URL=https://api.westfield-dominion.com
VITE_API_TIMEOUT=30000

# ============================================
# EMAIL SERVICE
# ============================================
# SendGrid configuration
SENDGRID_API_KEY=your_sendgrid_key_here
SENDGRID_FROM_EMAIL=info@westfield-dominion.com

# Email recipients
ADMIN_EMAIL=admin@westfield-dominion.com
SALES_EMAIL=sales@westfield-dominion.com
LEASING_EMAIL=leasing@westfield-dominion.com
EVENTS_EMAIL=events@westfield-dominion.com

# ============================================
# ANALYTICS & TRACKING
# ============================================
# Google Analytics
VITE_GA_ID=G-XXXXXXXXXX
VITE_GTM_ID=GTM-XXXXXXXX

# Sentry error tracking
VITE_SENTRY_DSN=https://key@sentry.io/project-id

# Segment analytics
VITE_SEGMENT_WRITE_KEY=your_segment_key_here

# ============================================
# SOCIAL & MARKETING
# ============================================
VITE_FACEBOOK_PIXEL_ID=your_pixel_id
VITE_LINKEDIN_TRACKER_ID=your_tracker_id
VITE_TWITTER_PIXEL_ID=your_pixel_id

# ============================================
# VIDEO & MEDIA
# ============================================
# Cloudinary for media management
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Vimeo API (if using Vimeo for videos)
VIMEO_ACCESS_TOKEN=your_vimeo_token

# ============================================
# AUTHENTICATION
# ============================================
# Optional: API key for protected endpoints
API_SECRET_KEY=your_super_secret_key_here

# ============================================
# DATABASE (Optional - for lead management)
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/westfield
REDIS_URL=redis://localhost:6379

# ============================================
# DEPLOYMENT
# ============================================
# Vercel
VERCEL_PROJECT_ID=your_project_id
VERCEL_ORG_ID=your_org_id

# Netlify
NETLIFY_SITE_ID=your_site_id
NETLIFY_AUTH_TOKEN=your_auth_token

# GitHub Pages
GITHUB_TOKEN=your_github_token

# ============================================
# CDN & STATIC ASSETS
# ============================================
CDN_URL=https://cdn.westfield-dominion.com
ASSET_PATH=/assets

# ============================================
# CACHING
# ============================================
CACHE_STRATEGY=aggressive
CACHE_TTL=3600
CACHE_MAX_AGE=86400

# ============================================
# SECURITY
# ============================================
# CORS settings
CORS_ORIGIN=https://westfield-dominion.com
CORS_CREDENTIALS=true

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900000

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AI_GENERATION=true
FEATURE_PERSONALIZATION=true
FEATURE_VIDEO_BACKGROUNDS=true
FEATURE_ANIMATIONS=true
FEATURE_KEYBOARD_NAV=true

# ============================================
# MONITORING & LOGGING
# ============================================
LOG_LEVEL=info
DEBUG=false
MONITORING_ENABLED=true

# ============================================
# DEVELOPMENT ONLY
# ============================================
# These should NOT be set in production
MOCK_DATA=false
DEBUG_MODE=false
SKIP_AUTH=false
